# Verbindung zur Postgres-Datenbank (in Coolify: "Postgres URL (internal)" der Datenbank)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/storyboard

# Passwort für die App (kann später in der App geändert werden)
APP_PASSWORD=bitte-aendern

# Optional
# PORT=3000
# DATABASE_SSL=false        # true, wenn die Datenbank nur per TLS erreichbar ist
# SESSION_SECRET=           # leer = wird automatisch erzeugt und in der Datenbank gespeichert
